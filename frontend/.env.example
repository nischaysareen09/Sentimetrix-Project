# Copy this file to .env and point it at your backend.
#
# Previously the backend URL was hardcoded as http://localhost:8000 inside
# 4 separate components (App.jsx, DeepChart.jsx, AIAnalyst.jsx, and the
# /analyze call) — that only worked on localhost. Now every API call goes
# through src/lib/api.js, which reads this single env var.
#
# Local dev (default if unset): http://localhost:8000
# Production (Render, etc.):    https://your-backend.onrender.com
VITE_API_URL=http://localhost:8000
